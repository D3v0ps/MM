# Miljonmatch – miljövariabler. Kopiera till .env.local för lokal utveckling. Lägg ALDRIG riktiga värden i repot.
# I testmiljön och produktion sätts värdena i Vercel (Settings -> Environment Variables). Förklaring, exempel och var
# värdena finns: docs/DRIFT.md avsnitt 5. Hemliga värden aldrig med prefixet NEXT_PUBLIC_.
#
# Domän (SPEC §11, beslut 2026-10-01): testmiljön på https://www.miljonmatch.se tills produktionen startar (miljonmatch.se
# skickas vidare till www). Sedan produktionen på miljonmatch.se och testmiljön på test.miljonmatch.se.
# DNS för miljonmatch.se hos one.com. E-post från notis@miljonmatch.se via Resend (EU) – beslut 2026-10-01.

# ---------------------------------------------------------------- Körläge
# memory   = påhittade testdata i minnet, välj testperson i verktygsfältet (lokal utveckling, e2e). Standard.
# supabase = Postgres i Stockholm med RLS och inloggning med e-postkod (testmiljön och produktion).
MM_BACKEND=memory
# Bara minnesläget. Tomt = prototypens testdata och demoklockan (1 februari 2027). empty = tomt testdata som en nystartad
# produktion (bara avtalet, konfigurationen och de sju kollegorna) med riktig tid – beslut 2026-10-08.
MM_SEED=

# Klockan i supabase-läget. real = riktig tid (produktion sedan 2026-10-08). Tomt = testtid i testmiljön (epokerna i app_settings).
MM_CLOCK=

# Appens adress utan snedstreck på slutet – den adress som INTE skickas vidare (länkar i mejl och deltagarens
# inspelningslänk /rost/…). Testmiljön just nu: https://www.miljonmatch.se (samma som Site URL i Supabase Auth).
MM_APP_URL=

# ---------------------------------------------------------------- Supabase (Project Settings -> API Keys)
# Testmiljön: https://blxupsebzzhmjitaywev.supabase.co (ref blxupsebzzhmjitaywev, eu-north-1). Se docs/MILJOER.md.
SUPABASE_URL=
# Publik nyckel (sb_publishable_…). Används bara på servern – webbläsaren pratar aldrig direkt med Supabase.
SUPABASE_PUBLISHABLE_KEY=
# HEMLIG (sb_secret_…). Service role – bara för systemsteg på servern. Aldrig med prefixet NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Inloggning
# HEMLIG. Nyckel för att hasha e-post och IP i login_attempts. Skapa med: openssl rand -base64 32
MM_LOGIN_HASH_SECRET=
# HEMLIG, valfri. Signerar sessionskakan mm_last_seen (60 minuters inaktivitet). Tom = samma som MM_LOGIN_HASH_SECRET.
MM_SESSION_SECRET=
# Tillåtna e-postdomäner för Miljonbemannings personal – vid inloggning och i "Lägg till kollega" (kommunernas domäner står i
# databasen). Standard: miljonbemanning.se
MM_STAFF_EMAIL_DOMAINS=miljonbemanning.se

# ---------------------------------------------------------------- Personnummer (CLAUDE.md punkt 2)
# HEMLIGA. AES-256-GCM (MM_PNR_KEY, exakt 32 byte som base64) och HMAC-SHA256 för sökning (MM_PNR_HMAC_KEY, minst 32 byte).
# Två OLIKA nycklar, egna per miljö. Skapa var och en med: openssl rand -base64 32
# Nycklarna kan inte bytas utan att alla personnummer krypteras om och alla sökhashar räknas om (docs/DRIFT.md 5.1).
# Behövs bara i supabase-läget (minnesläget använder testdatats ersättning).
MM_PNR_KEY=
MM_PNR_HMAC_KEY=

# ---------------------------------------------------------------- E-post (Resend) – se docs/UTSKICK.md
# HEMLIG. API-nyckel med bara sändrätt för domänen miljonmatch.se. Används för notiserna OCH inloggningskoderna – appen
# skickar koden själv (beslut 2026-10-02, Supabase Auth skickar inga mejl). Saknas den kan ingen logga in.
RESEND_API_KEY=
# Avsändare för notiserna och inloggningskoderna: Miljonmatch <notis@miljonmatch.se>
MM_EMAIL_FROM=
# Svarsadress för notiserna. Produktion: avrop@miljonbemanning.se (svar på ordererkännandet hamnar i avropsflödet). Tom i
# testmiljön. Kodmejlet har aldrig någon svarsadress.
MM_EMAIL_REPLY_TO=
# Adresser eller @domäner som får mejl och inloggningskoder. Kommatecken mellan. Inget annat får mejl, inte ens kodmejl.
# Produktion (skarp drift sedan 2026-10-08): @miljonbemanning.se tills Botkyrka släpps in – sedan @miljonbemanning.se,@botkyrka.se
# eller tomt (då stoppas inte längre något mejl). Testmiljön: hela adresser, aldrig @miljonbemanning.se (testdatat har påhittade
# adresser på den domänen); tomt i testmiljön = ingen får mejl. Testmiljön (de sju testarna, docs/DRIFT.md avsnitt 11):
# karim.khalil@miljonbemanning.se,ali.khalil@miljonbemanning.se,sara.salah@miljonbemanning.se,adam.abdalla@miljonbemanning.se,shafik.muwanga@miljonbemanning.se,moda.habib@miljonbemanning.se,yacine.laghmari@miljonbemanning.se
MM_EMAIL_ALLOWLIST=
# Bara testmiljön: mejl till testpersoner går i stället till den här testaren, med raden "Testmiljö – det här mejlet
# skulle ha gått till <roll/organisation>". Måste finnas i MM_EMAIL_ALLOWLIST. Ignoreras i produktion – lämna tom där.
# Gäller aldrig inloggningskoder: koden går bara till den som loggar in.
MM_EMAIL_REDIRECT_TO=

# ---------------------------------------------------------------- Bakgrundsjobb – se docs/UTSKICK.md
# HEMLIG, minst 16 tecken. Krävs som "Authorization: Bearer …" för /api/jobs/run. Skapa med: openssl rand -base64 32
MM_JOBS_SECRET=

# ---------------------------------------------------------------- AI och röstinspelning – se docs/AI.md och docs/DRIFT.md avsnitt 10
# Gemini via Google Cloud Vertex AI, EU multi-region-endpoint (aiplatform.eu.rep.googleapis.com, location eu). ALDRIG AI Studio
# eller en Gemini API-nyckel (AIza…), aldrig global endpoint – appen vägrar andra adresser.
# vertex | simulated | off. Tomt = simulated i testmiljön (påhittade svar) och off i produktion. Produktion kör aldrig simulated.
MM_AI_PROVIDER=
# Gemini Flash-modellens id i Vertex AI (Model Garden), exakt stavning. Kontrolleras inte mot nätet.
MM_AI_MODEL=
# Google Cloud-projektets id (annars project_id ur nyckeln).
GOOGLE_VERTEX_PROJECT=
# Valfri. Får bara vara eu – allt annat stoppas.
GOOGLE_VERTEX_LOCATION=
# HEMLIG. Tjänstekontots JSON-nyckel (rollen Vertex AI User) som base64 på en rad: base64 -w0 nyckel.json
GOOGLE_SERVICE_ACCOUNT_KEY=
# Prislista för kostnaden i ai_runs, öre per miljon token enligt Googles prislista för EU-endpointen. Tom = kostnad 0.
# Exempel (kontrollera aktuella priser): {"audioIn":1100,"textIn":330,"output":2750}
MM_AI_PRICES=
# Valfri resonemangsnivå: minimal | low | medium | high. Tom = lägsta rimliga (transkribering minimal, övrigt low).
MM_AI_THINKING=

# ---------------------------------------------------------------- Mejlinläsning från avrop@ – Microsoft Graph (docs/DRIFT.md avsnitt 12)
# Jobbet inbox_import läser olästa mejl i brevlådans Inkorg varannan minut och flyttar dem till mappen Inläst. Saknas någon
# av de fyra första variablerna gör jobbet ingenting och /admin/integrationer visar "Inte kopplad – så här kopplar du".
# Katalog-id (tenant) i Microsoft Entra.
MS_GRAPH_TENANT_ID=
# Appregistreringens klient-id (applikations-id).
MS_GRAPH_CLIENT_ID=
# HEMLIG. Klienthemligheten – bara i Vercel, aldrig i repot. Byt den innan den går ut (Entra visar datumet).
MS_GRAPH_CLIENT_SECRET=
# Brevlådan som läses (appen får bara nå den, via en ApplicationAccessPolicy i Exchange Online).
MM_INBOX_MAILBOX=avrop@miljonbemanning.se
# Mappen dit inlästa mejl flyttas (skapas om den saknas). Standard: Inläst
MM_INBOX_DONE_FOLDER=Inläst
