# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prototypbygget (publiceras som artefakt, byggs från källkoden)
/dist-demo/
/playwright-report/
/test-results/

# Mallen för miljövariabler ska finnas i repot (utan värden)
!.env.example

# Kopian som `npx skills add` lägger för andra agentverktyg – bara .claude/skills/ versionshanteras
.agents/
